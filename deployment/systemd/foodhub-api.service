[Unit]
Description=FoodHub FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=foodhub
Group=www-data
WorkingDirectory=/opt/foodhub/backend
EnvironmentFile=/etc/foodhub/backend.env
ExecStart=/opt/foodhub/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 3
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

